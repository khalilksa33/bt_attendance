[Unit]
Description=IICC Attendance Admin Dashboard - Employee Location Manager
After=network.target

[Service]
Type=simple
User=frappe
WorkingDirectory=/home/frappe/bt_attendance
ExecStart=/bin/bash -c 'cd /home/frappe/bt_attendance && source .venv/bin/activate && python admin_dashboard.py'
Restart=always
RestartSec=10
StandardOutput=append:/home/frappe/bt_attendance/logs/admin_dashboard.log
StandardError=append:/home/frappe/bt_attendance/logs/admin_dashboard.log

[Install]
WantedBy=multi-user.target
