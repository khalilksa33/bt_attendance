# BT Attendance - Environment Variables Template
# Copy this file to .env and fill in your values

# ==================== Portal Configuration ====================
PORT=5001
PORTAL_ACCESS_CODE=optional-access-code-here

# ==================== Admin Portal Configuration ====================
ADMIN_PORTAL_PORT=5002
ADMIN_PORTAL_USERNAME=admin
ADMIN_PORTAL_PASSWORD=YourSecurePassword123!

# ==================== ERP Configuration ====================
ERP_URL=https://erp.iicc.sa
ERP_API_KEY=75ed1d96c4e96e3
ERP_API_SECRET=15e472dbe138756
ERP_ATTENDANCE_DOCTYPE=Attendance
ERP_ATTENDANCE_EMPLOYEE_FIELD=employee
ERP_ATTENDANCE_DATE_FIELD=attendance_date
ERP_ATTENDANCE_TIME_FIELD=attendance_time

# ==================== Biometric Device ====================
BIOMETRIC_IP=192.168.8.4
BIOMETRIC_PORT=4370

# ==================== Database ====================
LOG_DB_PATH=logs/attendance_logs.db
OUTPUT_DIR=reports

# ==================== Email Configuration ====================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@company.com
EMAIL_PASS=your-app-specific-password
RECIPIENT_EMAIL=manager@company.com,admin@company.com

# ==================== WhatsApp Notification (Optional) ====================
# Using Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
WHATSAPP_FROM_NUMBER=+1234567890
WHATSAPP_TO_NUMBER=+1234567890,+0987654321

# Using Generic API
WHATSAPP_API_URL=https://your-whatsapp-api.com/send
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_MESSAGE_TEMPLATE=Daily check-in log for {month_name} is ready. File: {filename}
WHATSAPP_MEDIA_URL_BASE=https://your-server.com/reports

# ==================== Report Settings ====================
LOGO_PATH=reports/images/iicc_final_logo.jpeg
FORCE_SEND=0

# ==================== Remote Check-in File ====================
REMOTE_CHECKIN_FILE=remote_checkins.json
