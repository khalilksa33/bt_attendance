[Unit]
Description=BT Attendance Bot - Daily Report Generator
After=network.target
Documentation=https://github.com/khalilksa33/bt_attendance

[Service]
Type=oneshot
User=%u
WorkingDirectory=%h/bt_attendance
Environment="PATH=%h/bt_attendance/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/bt_attendance/.venv/bin/python daily_checkin_log.py
StandardOutput=append:%h/bt_attendance/logs/bot.log
StandardError=append:%h/bt_attendance/logs/bot.log
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target
